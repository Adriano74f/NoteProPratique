{% extends 'base.html.twig' %}

{% block title %}Student{% endblock %}

{% block body %}
    <h1>Notes de {{ app.user.name }}</h1>

    <h2>Moyennes par matière</h2>
    <table class="table">
        <thead>
        <tr>
            <th>Matière</th>
            <th>Moyenne</th>
        </tr>
        </thead>
        <tbody>
        {% for subject in subjects %}
            <tr>
                <td>{{ subject.name }}</td>
                <td>{{ student.getAverageBySubject(subject) }}/20</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <table class="table">
        <thead>
        <tr>
            <th scope="col">Evaluation</th>
            <th scope="col">Note</th>
            <th scope="col">Barème</th>
        </tr>
        </thead>
        <tbody>
        {% for gr in student.grades %}
        <tr>
            <td>{{ gr.evaluation.label }}</td>
            <td>{{ gr.grade }}</td>
            <td>{{ gr.evaluation.bareme }}</td>
        </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
